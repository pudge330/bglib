{
    "name": "bglib",
    "version": "1.0.0",
    "description": "Browser-oriented JavaScript helpers and reusable modules",
    "main": "dist/bglib.js",
    "module": "dist/bglib.esm.mjs",
    "browser": "dist/bglib.js",
    "exports": {
        ".": {
            "import": "./dist/bglib.esm.mjs",
            "require": "./dist/bglib.js",
            "default": "./dist/bglib.js"
        }
    },
    "files": [
        "dist/",
        "README.md"
    ],
    "scripts": {
        "build": "npm run js",
        "js": "webpack",
        "css": "node -e \"console.log('No library CSS sources to build.')\"",
        "dev": "webpack --env format=umd",
        "prod": "webpack --env format=umd --env production=true",
        "watch": "webpack --watch",
        "site:vendor": "webpack --config webpack.site.config.js"
    },
    "author": "Brandon Garcia (public@bgarcia.dev)",
    "license": "MIT",
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "babel-loader": "^10.1.1",
        "copy-webpack-plugin": "^13.0.1",
        "css-content-loader": "^1.0.0",
        "terser-webpack-plugin": "^5.6.1",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2"
    }
}
